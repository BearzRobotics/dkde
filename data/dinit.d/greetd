# dinit service for the login manager. Copy to /etc/dinit.d/greetd and enable
# it with:  dinitctl enable greetd
#
# greetd takes over the virtual terminal named in /etc/greetd/config.toml
# (vt = 1), so do not also run a getty on that terminal.
type            = process
command         = /usr/sbin/greetd
restart         = true
smooth-recovery = true
# The login screen and the session both need a seat. Without logind that is
# seatd, so greetd starts only after it is ready (see the seatd service). Under
# elogind or systemd there is no seatd service: remove the next line.
depends-on      = seatd
# dbus (the system bus) is not needed by greetd itself; list it in your boot
# service's waits-for for NetworkManager and the rest.
