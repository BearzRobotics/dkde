[Desktop Entry]
Type=Application
Name=Image Viewer
GenericName=Image Viewer
Comment=View pictures
Exec=dkde-view %U
Icon=image-x-generic
Categories=Graphics;Viewer;
MimeType=image/png;image/jpeg;image/gif;image/bmp;image/webp;image/svg+xml;image/svg+xml-compressed;image/tiff;image/x-icon;image/vnd.microsoft.icon;image/avif;image/heic;image/heif;image/jxl;image/x-tga;image/qoi;image/x-qoi;image/vnd.zbrush.pcx;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-xpixmap;image/x-xbitmap;image/apng;
Keywords=photo;picture;image;
StartupWMClass=org.dkde.view
