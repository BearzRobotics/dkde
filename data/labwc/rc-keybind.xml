<!-- Example labwc keybinding for dkde. Merge this <keybind> into the
     <keyboard> section of ~/.config/labwc/rc.xml.
     A lone Super press-and-release toggles the start menu; onRelease keeps
     Super+<key> shortcuts working (documented in labwc-config(5), 0.9.3). -->
<keybind key="Super_L" onRelease="yes">
  <action name="Execute" command="dkde-panel msg toggle-menu"/>
</keybind>
<keybind key="C-S-Escape">
  <action name="Execute" command="dkde-tasks"/>
</keybind>
<keybind key="Print">
  <action name="Execute" command="dkde-snip --full"/>
</keybind>
<keybind key="S-Print">
  <action name="Execute" command="dkde-snip --region"/>
</keybind>
<!-- Virtual desktops (the number of desktops is <desktops><number> in rc.xml). -->
<keybind key="C-A-Left">
  <action name="GoToDesktop" to="left"/>
</keybind>
<keybind key="C-A-Right">
  <action name="GoToDesktop" to="right"/>
</keybind>
<keybind key="C-A-S-Left">
  <action name="SendToDesktop" to="left"/>
</keybind>
<keybind key="C-A-S-Right">
  <action name="SendToDesktop" to="right"/>
</keybind>
<keybind key="XF86AudioRaiseVolume">
  <action name="Execute" command="dkde-panel msg volume-up"/>
</keybind>
<keybind key="XF86AudioLowerVolume">
  <action name="Execute" command="dkde-panel msg volume-down"/>
</keybind>
<keybind key="XF86AudioMute">
  <action name="Execute" command="dkde-panel msg volume-mute"/>
</keybind>
<keybind key="XF86MonBrightnessUp">
  <action name="Execute" command="dkde-panel msg brightness-up"/>
</keybind>
<keybind key="XF86MonBrightnessDown">
  <action name="Execute" command="dkde-panel msg brightness-down"/>
</keybind>
<keybind key="C-A-t">
  <action name="Execute" command="dkde-term"/>
</keybind>
<keybind key="C-A-l">
  <action name="Execute" command="dkde-panel msg lock"/>
</keybind>
<!-- labwc's own window shortcuts. dkde writes these itself and removes <default />
     from <keyboard>, so they can be changed in Settings > Keyboard shortcuts. -->
<keybind key="A-Tab">
  <action name="NextWindow"/>
</keybind>
<keybind key="A-S-Tab">
  <action name="PreviousWindow"/>
</keybind>
<keybind key="A-F4">
  <action name="Close"/>
</keybind>
<keybind key="W-a">
  <action name="ToggleMaximize"/>
</keybind>
<keybind key="W-Left">
  <action name="SnapToEdge" direction="left"/>
</keybind>
<keybind key="W-Right">
  <action name="SnapToEdge" direction="right"/>
</keybind>
<keybind key="W-Up">
  <action name="SnapToEdge" direction="up"/>
</keybind>
<keybind key="W-Down">
  <action name="SnapToEdge" direction="down"/>
</keybind>
<keybind key="A-Space">
  <action name="ShowMenu" menu="client-menu"/>
</keybind>
