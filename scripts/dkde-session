#!/bin/sh
# The dkde Wayland session: greetd (or any login manager, or a tty) runs this.
# It prepares the environment a systemd-less system does not provide, then
# starts labwc under a private session D-Bus when one can be had. The labwc
# autostart (see data/labwc/autostart) starts the panel.

export XDG_SESSION_TYPE=wayland

# This session's own messages go to ~/.local/state/dkde/session.log (the last
# session only). When labwc cannot start (no seat, no GPU), greetd just shows the
# login screen again; without this log nothing says why. Run from a terminal,
# the messages stay on the terminal.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dkde"
mkdir -p "$state_dir" 2>/dev/null
session_log="$state_dir/session.log"
if [ ! -t 2 ] && { : > "$session_log"; } 2>/dev/null; then
    exec >>"$session_log" 2>&1
fi
echo "dkde-session: $(date) user $(id -un) ($(id -u)), groups: $(id -Gn)"
# Keep each program's warnings and errors in ~/.local/state/dkde/<program>.log
# (set DKDE_LOG=debug for more, or DKDE_LOG_FILE to somewhere else).
export DKDE_LOG_FILE="${DKDE_LOG_FILE:-auto}"
export XDG_CURRENT_DESKTOP=dkde
export XDG_SESSION_DESKTOP=dkde

# Without logind nobody creates /run/user/$UID. Use it if it exists and is
# ours, otherwise make a private directory.
if [ -z "$XDG_RUNTIME_DIR" ]; then
    if [ -d "/run/user/$(id -u)" ] && [ -w "/run/user/$(id -u)" ]; then
        XDG_RUNTIME_DIR="/run/user/$(id -u)"
    else
        XDG_RUNTIME_DIR="${TMPDIR:-/tmp}/dkde-runtime-$(id -u)"
        mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
    fi
    export XDG_RUNTIME_DIR
fi

# A login shell's profile (PATH and so on) is not read by greetd; do it here.
[ -f /etc/profile ] && . /etc/profile
[ -f "$HOME/.profile" ] && . "$HOME/.profile"

# The language and formats chosen in Settings > Language & region: plain
# KEY=value lines in ~/.config/locale.conf. Read line by line, not sourced, and
# only for the locale variables, so the file cannot run anything.
locale_conf="${XDG_CONFIG_HOME:-$HOME/.config}/locale.conf"
if [ -f "$locale_conf" ]; then
    while IFS='=' read -r key value; do
        case "$key" in
            LANG|LANGUAGE|LC_TIME|LC_NUMERIC|LC_MONETARY|LC_PAPER|LC_MEASUREMENT) export "$key=$value" ;;
        esac
    done < "$locale_conf"
fi

# The first login only: put dkde's labwc config, folders and keybindings in
# place. It never runs again by itself; run `dkde-setup` by hand to re-check.
command -v dkde-setup >/dev/null 2>&1 && dkde-setup --once >/dev/null 2>&1

# Without logind or elogind, the session's display and input devices come from
# seatd, through /run/seatd.sock. Say what is wrong when that cannot work: labwc
# only reports that it found no seat.
seat_check() {
    [ -d /run/systemd/seats ] && return 0            # logind or elogind
    [ -n "$LIBSEAT_BACKEND" ] && [ "$LIBSEAT_BACKEND" != seatd ] && return 0
    # No seatd installed: libseat is built to use its own backend (or this is a
    # system that has no use for the check). Nothing to wait for or complain about.
    have_seatd=no
    for candidate in /usr/sbin/seatd /usr/bin/seatd /sbin/seatd /bin/seatd /usr/local/sbin/seatd /usr/local/bin/seatd; do
        [ -x "$candidate" ] && have_seatd=yes
    done
    if [ "$have_seatd" = no ] && [ -z "$SEATD_SOCK" ] && [ ! -S /run/seatd.sock ]; then
        echo "dkde-session: seatd is not installed; libseat will use its own backend"
        return 0
    fi
    sock="${SEATD_SOCK:-/run/seatd.sock}"
    waited=0
    while [ ! -S "$sock" ] && [ "$waited" -lt 10 ]; do
        sleep 1
        waited=$((waited + 1))
    done
    if [ ! -S "$sock" ]; then
        echo "dkde-session: $sock does not exist, so seatd is not running."
        echo "dkde-session: start it (dinit: dinitctl start seatd; SysV: the seatd script), and make"
        echo "dkde-session: greetd depend on it so it is ready first. Debian and Ubuntu install seatd in /usr/sbin."
        return 1
    fi
    if [ ! -r "$sock" ] || [ ! -w "$sock" ]; then
        echo "dkde-session: $sock exists but $(id -un) cannot use it:"
        ls -l "$sock"
        echo "dkde-session: add the user to the socket's group (usually video): sudo usermod -aG video $(id -un), then sign in again."
        return 1
    fi
    echo "dkde-session: seatd is at $sock"
}
seat_check

# A session bus is optional (SPEC.md 2): notifications and the tray use it.
started=$(date +%s)
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null 2>&1; then
    dbus-run-session -- labwc "$@"
else
    labwc "$@"
fi
status=$?
echo "dkde-session: labwc exited with status $status after $(( $(date +%s) - started )) s"
exit "$status"
