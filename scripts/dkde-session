#!/bin/sh
# The dkde Wayland session: greetd (or any login manager, or a tty) runs this.
# It prepares the environment a systemd-less system does not provide, then
# starts labwc under a private session D-Bus when one can be had. The labwc
# autostart (see data/labwc/autostart) starts the panel.

export XDG_SESSION_TYPE=wayland
# Keep each program's warnings and errors in ~/.local/state/dkde/<program>.log
# (set DKDE_LOG=debug for more, or DKDE_LOG_FILE to somewhere else).
export DKDE_LOG_FILE="${DKDE_LOG_FILE:-auto}"
export XDG_CURRENT_DESKTOP=dkde
export XDG_SESSION_DESKTOP=dkde

# Without logind nobody creates /run/user/$UID. Use it if it exists and is
# ours, otherwise make a private directory.
if [ -z "$XDG_RUNTIME_DIR" ]; then
    if [ -d "/run/user/$(id -u)" ] && [ -w "/run/user/$(id -u)" ]; then
        XDG_RUNTIME_DIR="/run/user/$(id -u)"
    else
        XDG_RUNTIME_DIR="${TMPDIR:-/tmp}/dkde-runtime-$(id -u)"
        mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
    fi
    export XDG_RUNTIME_DIR
fi

# A login shell's profile (PATH and so on) is not read by greetd; do it here.
[ -f /etc/profile ] && . /etc/profile
[ -f "$HOME/.profile" ] && . "$HOME/.profile"

# The language and formats chosen in Settings > Language & region: plain
# KEY=value lines in ~/.config/locale.conf. Read line by line, not sourced, and
# only for the locale variables, so the file cannot run anything.
locale_conf="${XDG_CONFIG_HOME:-$HOME/.config}/locale.conf"
if [ -f "$locale_conf" ]; then
    while IFS='=' read -r key value; do
        case "$key" in
            LANG|LANGUAGE|LC_TIME|LC_NUMERIC|LC_MONETARY|LC_PAPER|LC_MEASUREMENT) export "$key=$value" ;;
        esac
    done < "$locale_conf"
fi

# The first login only: put dkde's labwc config, folders and keybindings in
# place. It never runs again by itself; run `dkde-setup` by hand to re-check.
command -v dkde-setup >/dev/null 2>&1 && dkde-setup --once >/dev/null 2>&1

# A session bus is optional (SPEC.md 2): notifications and the tray use it.
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- labwc "$@"
fi
exec labwc "$@"
