#!/bin/sh
# Guest init for scripts/qemu-console-test. Runs one dkde-console per VT, like an
# init system would, and reports on the serial port.
mount -t proc proc /proc; mount -t sysfs sys /sys; mount -t devtmpfs dev /dev
mkdir -p /dev/pts; mount -t devpts devpts /dev/pts; mount -t tmpfs run /run
echo "init: starting" > /dev/ttyS0
ls /dev/dri /dev/input > /dev/ttyS0 2>&1
for v in 1 2; do
  ( while :; do /usr/bin/dkde-console --vt $v >> /dev/ttyS0 2>&1; echo "console $v exited $?" > /dev/ttyS0; sleep 1; done ) &
done
exec /bin/sh -c 'while :; do sleep 100; done'
